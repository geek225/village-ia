# Configuration des clés API pour Village IA (Environnement Frontend Vite)
# Les variables préfixées par VITE_ sont accessibles dans l'application.
# Ne commitez JAMAIS vos clés secrètes dans Git (.env est ignoré).

# Fournisseur Google Gemini (Recommandé)
VITE_GEMINI_API_KEY=

# Fournisseur OpenRouter (Accès universel Llama, Mistral, DeepSeek, Claude, GPT)
VITE_OPENROUTER_API_KEY=

# Fournisseur OpenAI (Direct API GPT-4o / GPT-4o-mini)
VITE_OPENAI_API_KEY=

# Mode d'exécution (true = simulation locale de secours si aucune clé n'est fournie)
VITE_ENABLE_SIMULATION_FALLBACK=true

# Fournisseur xKiro (Multi-modèles gratuits)
VITE_XKIRO_API_KEY=

# Fournisseur Agnes AI (Modèles Agnes 2.5 / 3.0 Flash & Pro)
VITE_AGNES_API_KEY=
